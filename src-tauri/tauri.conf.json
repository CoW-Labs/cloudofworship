{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cloud of Worship",
  "version": "0.57.0",
  "identifier": "com.cloudofworship.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run generate"
  },
  "app": {
    "windows": [
      {
        "title": "Cloud of Worship - Control Center",
        "maximized": true,
        "width": 1600,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "label": "main",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/cow-media/**/*"
        ]
      },
      "capabilities": [
        {
          "identifier": "main-capability",
          "windows": ["main", "live-output", "stage-display"],
          "permissions": [
            "core:default",
            "core:webview:allow-create-webview-window",
            "core:webview:allow-webview-close",
            "core:webview:allow-webview-position",
            "core:webview:allow-webview-size",
            "core:window:allow-create",
            "core:window:allow-close",
            "core:window:allow-destroy",
            "core:window:allow-set-focus",
            "core:window:allow-set-fullscreen",
            "core:window:allow-set-position",
            "core:window:allow-set-size",
            "core:window:allow-set-decorations",
            "core:window:allow-set-always-on-top",
            "shell:allow-open",
            "updater:default",
            "process:allow-restart",
            "fs:allow-exists",
            "fs:allow-mkdir",
            "fs:allow-open",
            "fs:allow-write",
            "fs:allow-write-file",
            "fs:allow-write-text-file",
            "fs:allow-read-file",
            "fs:allow-read-text-file",
            "fs:allow-stat",
            "fs:allow-read-dir",
            "fs:allow-remove",
            "fs:allow-rename",
            {
              "identifier": "fs:scope",
              "allow": [
                "$APPLOCALDATA/cow-media",
                "$APPLOCALDATA/cow-media/**/*"
              ]
            }
          ]
        }
      ]
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "shell": {
      "open": "^https?://"
    },
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxRDg0OTNGREE5OTExNTAKUldSUUVabmFQMG5ZWWF1ZDlRUVFxSi9OZ1BtZWthdXE3c2lESXVweXBUbjdkcWRwQ3JJNHR0RVUK",
      "endpoints": [
        "https://felixfavour.github.io/minimalist-church-presentation-software/latest.json"
      ],
      "dialog": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
